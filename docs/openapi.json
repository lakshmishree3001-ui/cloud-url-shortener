  "info": {
    "title": "Cloud-Based URL Shortener",
    "description": "Production-ready URL Shortener simulation built with FastAPI, SQLite, and Base62 collision-resistant hashing. Designed to reflect enterprise AWS Cloud Architecture (Route 53 -> CloudFront -> ALB -> ECS -> RDS/DynamoDB -> CloudWatch).",
    "version": "2.0.0"
  },

      "URLBatchRequest": {
        "properties": {
          "urls": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Urls",
            "description": "List of long URLs to shorten simultaneously",
            "examples": [
              [
                "https://aws.amazon.com/ec2/",
                "https://aws.amazon.com/s3/",
                "https://aws.amazon.com/dynamodb/"
              ]
            ]
          },
          "expires_in_hours": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 8760.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires In Hours",
            "description": "Optional expiration in hours for all URLs in the batch"
          },
          "expires_in_days": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 365.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires In Days",
            "description": "Optional expiration in days for all URLs in the batch"
          }
        },
        "type": "object",
        "required": [
          "urls"
        ],
        "title": "URLBatchRequest",
        "description": "Request schema for batch shortening multiple URLs with optional expiration."
      },

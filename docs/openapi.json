          "successful_count",
          "items"
        ],
        "title": "URLBatchResponse",
        "description": "Response returned for batch URL shortening."
      },
      "URLShortenRequest": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url",
            "description": "Target destination URL to shorten",
            "examples": [
              "https://aws.amazon.com/blogs/aws/"
            ]
          },
          "custom_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Code",
            "description": "Optional custom vanity code (4-16 alphanumeric characters)",
            "examples": [
              "aws-blog"
            ]
          },
          "expires_in_hours": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 8760.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires In Hours",
            "description": "Optional expiration in hours (1 to 8760 hours, e.g., 24 for 1 day)",
            "examples": [
              24
            ]
          },
          "expires_in_days": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 365.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires In Days",
            "description": "Optional expiration in days (1 to 365 days)",
            "examples": [
              7
            ]
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "URLShortenRequest",
        "description": "Request schema for shortening a URL with optional custom alias and expiration (TTL)."
      },
